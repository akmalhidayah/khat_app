+            f"received {list(metadata_class_mapping)}"
+        )
+    if errors:
+        raise ValueError("Invalid production class mapping: " + "; ".join(errors))
+    return {
+        "valid": True,
+        "class_names": list(CLASS_NAMES),
+        "class_indices": expected_indices,
+        "num_model_outputs": int(num_model_outputs),
